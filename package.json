{
  "name": "open-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "imports": {
      "#components/*": "./lib/components/*.js",
      "#*": "./lib/*.js"
    }
  },
  "bin": {
    "open-agent": "./bin/cli.mjs"
  },
  "scripts": {
    "build": "run build",
    "lint": "run lint --",
    "lint:check": "run lint:check",
    "local": "node --import ./scripts/source-hooks.ts scripts/packed-cli.ts run",
    "postbuild": "cp src/guest/*.sh lib/guest/ && chmod +x bin/cli.mjs",
    "postlint": "eslint --max-warnings 0 bin && sh -n src/guest/bootstrap-node.sh && sh -n src/guest/update-gate.sh",
    "prepare": "run prepare",
    "test": "run test",
    "test:e2e": "node --import ./scripts/source-hooks.ts scripts/packed-cli.ts test:e2e",
    "test:live": "node --import ./scripts/source-hooks.ts scripts/packed-cli.ts test:live",
    "test:live:fly": "node --import ./scripts/source-hooks.ts scripts/packed-cli.ts test:live:fly",
    "test:coverage": "run test:coverage --",
    "typecheck": "run typecheck"
  },
  "dependencies": {
    "@fly/sprites": "^0.2.3",
    "@stricli/core": "^1.3.0",
    "dotenv": "^18.0.6",
    "execa": "^9.6.1",
    "ink": "~8.0.0",
    "react": "^19.3.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@presetter/preset-esm": "^9.1.0",
    "@presetter/preset-react": "^9.1.0",
    "@presetter/preset-strict": "^9.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.0.0",
    "globals": "^17.13.0",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "presetter": "^9.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@12.11.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
